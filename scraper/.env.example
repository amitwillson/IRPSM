# Copy this file to .env and fill in your details. Never commit the real .env file.

IRPSM_BASE_URL=https://ircep.gov.in/IRPSM/LoginController
IRPSM_USER_ID=
IRPSM_PASSWORD=

# After you run recon.py against the login page, put the real field
# selectors here (see README "Step 1: Recon" section).
IRPSM_USERID_SELECTOR=
IRPSM_PASSWORD_SELECTOR=
IRPSM_LOGIN_BUTTON_SELECTOR=
IRPSM_OTP_SELECTOR=
IRPSM_OTP_SUBMIT_SELECTOR=

# The URL of the page that lists all works, once logged in.
# Leave blank until you've run recon_dashboard.py to find it.
IRPSM_WORKS_URL=

# Google Sheets export (see README "Google Sheets setup")
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GOOGLE_SHEET_NAME=IRPSM Works Export
